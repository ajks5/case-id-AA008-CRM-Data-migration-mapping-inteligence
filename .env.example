# AA008 CRM Data Migration Intelligence — Environment Configuration
# RealRails Agentic AI Batch 2 — Phase 2.3: Controlled LLM Enhancement

# LLM Provider configuration: "gemini" | "openai" | "mock"
# Default: automatically selects "gemini" if GEMINI_API_KEY is present, otherwise falls back to "mock"
LLM_PROVIDER=gemini

# Model name:
# For Gemini: gemini-3.5-flash-lite
# For OpenAI: gpt-4o-mini
LLM_MODEL=gemini-3.5-flash-lite

# API Credentials (DO NOT commit real keys; set in environment or local .env)
# Multi-key switching supported: provide comma-separated keys for automatic quota failover
GEMINI_API_KEYS=your_primary_gemini_key,your_backup_gemini_key
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEYS=your_primary_openai_key,your_backup_openai_key
# LLM_API_KEY=your_llm_api_key_here

# Network timeout in seconds for LLM invocations before triggering deterministic fallback
LLM_TIMEOUT=10.0

# Master toggle to enable/disable LLM enhancement layer (true/false)
LLM_ENABLED=true
