    for scn in scenarios:
        scn_id = scn["id"]
        print("-" * 80)
        print(f"Testing Scenario: {scn['name']} ({scn_id})")
        print(f"Expected Behavior: {scn['expected_behavior']}")

        resp = client.post("/api/migrate", json=scn["request"])
