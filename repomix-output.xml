import React from 'react';
import type { MigrationRecommendation } from '../api/client';

interface MappingTableProps {
  recommendation: MigrationRecommendation | null;
  workflowId: string;
}

export const MappingTable: React.FC<MappingTableProps> = ({
  recommendation,
  workflowId,
}) => {
  if (!recommendation) {
    return (
      <div id="section-mapping-table" className="card mb-6">
        <div className="card-header">
          <h2 className="text-lg font-bold text-gray-800">5. Decision Agent: Field Mapping Recommendations</h2>
          <p className="text-sm text-gray-500">Awaiting workflow execution.</p>
        </div>
        <div className="card-body text-center py-8 text-gray-400">
          Run the migration pipeline to view per-field mapping decisions produced by the Migration Decision Agent.
        </div>
      </div>
    );
  }

  const { overall_status, summary_counts, field_recommendations, review_items, triggered_rules } =
    recommendation;

  const getDecisionBadge = (decision: string) => {
    switch (decision) {
      case 'DIRECT_MAP':
        return <span className="badge badge-success font-bold">DIRECT_MAP</span>;
      case 'TRANSFORM':
        return <span className="badge badge-info font-bold">TRANSFORM</span>;
      case 'DEFAULT':
        return <span className="badge badge-purple font-bold">DEFAULT</span>;
      case 'REVIEW':
        return <span className="badge badge-error font-bold">REVIEW</span>;
      case 'UNMAPPED':
        return <span className="badge badge-neutral font-bold">UNMAPPED</span>;
      default:
        return <span className="badge">{decision}</span>;
    }
  };

  const getConfidenceColor = (score: number) => {
    if (score >= 90) return 'bg-emerald-500';
    if (score >= 70) return 'bg-blue-500';
    if (score >= 50) return 'bg-amber-500';
    return 'bg-rose-500';
  };

  return (
    <div id="section-mapping-table" className="card mb-6 border-slate-200 shadow-sm">
      <div className="card-header flex-between flex-wrap gap-2">
        <div>
          <div className="flex items-center gap-3 flex-wrap">
            <span className="badge badge-primary font-mono text-2xs uppercase">Product Bible §6 & §13</span>
            <h2 className="text-lg font-bold text-gray-800">5. Decision Agent: Per-Field Recommendations</h2>
            <span
              className={`badge font-bold px-2.5 py-1 text-xs ${
                overall_status === 'READY'
                  ? 'badge-success'
                  : overall_status === 'NEEDS_REVIEW'
                  ? 'badge-warning'
                  : 'badge-error'
              }`}
            >
              FINAL DECISION: {overall_status}
            </span>
          </div>
          <p className="text-xs text-gray-500 mt-1 font-mono">
            Synthesized by <strong>Migration Decision Agent</strong> • Workflow Run: {workflowId}
          </p>
        </div>

        {/* Counter Pills */}
        <div className="flex flex-wrap gap-1.5 text-xs font-semibold">
          <span className="stat-pill stat-pill-green">
            Direct: {summary_counts.DIRECT_MAP}
          </span>
          <span className="stat-pill stat-pill-blue">
            Transform: {summary_counts.TRANSFORM}
          </span>
          <span className="stat-pill stat-pill-purple">
            Default: {summary_counts.DEFAULT}
          </span>
          <span className="stat-pill stat-pill-red">
            Review: {summary_counts.REVIEW}
          </span>
          <span className="stat-pill stat-pill-gray">
            Unmapped: {summary_counts.UNMAPPED}
          </span>
        </div>
      </div>

      {/* Triggered Rules Banner */}
      <div className="px-5 py-2.5 bg-slate-50 border-b border-slate-200 flex-between flex-wrap gap-2 text-xs">
        <div className="flex items-center gap-2">
          <span className="font-semibold text-slate-700">⚖️ Triggered Deterministic Rules:</span>
          <div className="flex flex-wrap gap-1">
            {triggered_rules.map((rule) => (
              <span key={rule} className="font-mono text-3xs px-2 py-0.5 bg-indigo-50 text-indigo-700 border border-indigo-200 rounded font-semibold">
                {rule}
              </span>
            ))}
          </div>
        </div>
        <span className="text-2xs text-slate-500">
          Applied by Migration Decision Agent
        </span>
      </div>

      {review_items && review_items.length > 0 && (
        <div className="mx-4 mt-3 p-3 bg-amber-50 border-l-4 border-amber-500 rounded-r text-xs text-amber-900">
          <strong className="block mb-1 text-amber-800">⚠️ Flagged Items Requiring Human Review (Rules 4 & 5):</strong>
          <ul className="list-disc pl-4 space-y-0.5">
            {review_items.map((item, idx) => (
              <li key={idx} className="font-medium">
                {item}
              </li>
            ))}
          </ul>
        </div>
      )}

      <div className="card-body p-0">
        <div className="table-responsive">
          <table className="mapping-table">
            <thead>
              <tr>
                <th style={{ width: '22%' }}>Target Destination Field</th>
                <th style={{ width: '22%' }}>Mapped Source Field</th>
                <th style={{ width: '14%' }}>Decision</th>
                <th style={{ width: '14%' }}>Confidence</th>
                <th style={{ width: '28%' }}>Deterministic Rule & Evidence</th>
              </tr>
            </thead>
            <tbody>
              {field_recommendations.map((rec) => (
                <tr
                  key={rec.destination_field}
                  className={rec.requires_human_review ? 'row-review-flagged' : ''}
                >
                  <td className="font-bold text-gray-900 font-mono text-xs">
                    {rec.destination_field}
                  </td>
                  <td className="font-mono text-xs">
                    {rec.source_field ? (
                      <span className="text-indigo-600 font-semibold">{rec.source_field}</span>
                    ) : (
                      <span className="text-gray-400 italic">None (Unmapped)</span>
                    )}
                  </td>
                  <td>{getDecisionBadge(rec.decision)}</td>
                  <td>
                    <div className="flex items-center gap-2">
                      <div className="confidence-meter-bg">
                        <div
                          className={`confidence-meter-fill ${getConfidenceColor(
                            rec.confidence_score
                          )}`}
                          style={{ width: `${rec.confidence_score}%` }}
                        />
                      </div>
                      <span className="font-mono text-xs font-bold text-gray-700">
                        {rec.confidence_score}%
                      </span>
                    </div>
                  </td>
                  <td className="text-xs">
                    <div className="text-gray-800 leading-snug">{rec.evidence}</div>
                    <div className="flex items-center gap-2 mt-1">
                      <span className="badge badge-neutral text-3xs font-mono">
                        Rule: {rec.rule_id}
                      </span>
                      {rec.transformation && (
                        <span className="badge badge-info text-3xs font-mono">
                          Transform: {rec.transformation}
                        </span>
                      )}
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
};
</file>

<file path="frontend/src/components/RecentRuns.tsx">
import React from 'react';
import type { AuditRecord } from '../api/client';

interface RecentRunsProps {
  records: AuditRecord[];
  isLoading: boolean;
  errorMessage: string | null;
  onRefresh: () => void;
  onOpenAudit: (record: AuditRecord) => void;
}

function statusLabel(status: string) {
  if (status === 'READY') return { label: 'Ready for review', tone: 'success' };
  if (status === 'NEEDS_REVIEW') return { label: 'Review required', tone: 'warning' };
  if (status === 'BLOCKED') return { label: 'Blocked', tone: 'danger' };
  return { label: 'Recorded', tone: 'neutral' };
}

function formatTime(value: string) {
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return 'Date unavailable';
  return new Intl.DateTimeFormat(undefined, {
    dateStyle: 'medium',
    timeStyle: 'short',
  }).format(date);
}

function tablePair(reference: string) {
  const withoutPrefix = reference.replace(/^Migration\s+/i, '');
  const [source, destination] = withoutPrefix.split(/\s+->\s+/);
  return { source: source || withoutPrefix, destination: destination || '' };
}

export const RecentRuns: React.FC<RecentRunsProps> = ({
  records,
  isLoading,
  errorMessage,
  onRefresh,
  onOpenAudit,
}) => (
  <section className="product-panel product-history-panel" aria-labelledby="recent-heading">
    <div className="product-panel-heading">
      <div>
        <h2 id="recent-heading">Recent assessments</h2>
        <p>Review earlier mapping recommendations recorded by this service.</p>
      </div>
      <button className="product-button product-button-secondary" type="button" onClick={onRefresh} disabled={isLoading}>
        {isLoading ? 'Refreshing…' : 'Refresh list'}
      </button>
    </div>

    {errorMessage && <p className="product-history-error" role="status">{errorMessage}</p>}

    {isLoading && records.length === 0 ? (
      <div className="product-empty-inline" role="status">Loading recent assessments…</div>
    ) : records.length === 0 ? (
      <div className="product-empty-state">
        <h3>No assessments recorded yet</h3>
        <p>Completed mapping assessments will appear here while the service is running.</p>
        <p className="product-field-help">The current audit store is session-based and may clear when the service restarts.</p>
      </div>
    ) : (
      <div className="product-history-list">
        {records.map((record) => {
          const status = statusLabel(record.final_recommendation_status);
          const pair = tablePair(record.request_reference);
          const reviewCount = Number(record.major_outputs?.review_items_count ?? 0);
          const fieldsAnalyzed = Number(record.major_outputs?.fields_analyzed ?? 0);
          return (
            <article className="product-history-item" key={record.workflow_id}>
              <div className="product-history-main">
                <p className="product-history-pair">
                  <span>{pair.source}</span>
                  {pair.destination && <><span aria-hidden="true">→</span><span>{pair.destination}</span></>}
                </p>
                <p className="product-history-date">{formatTime(record.timestamp)}</p>
                <p className="product-history-meta">
                  {fieldsAnalyzed > 0 ? `${fieldsAnalyzed} destination fields checked` : 'Assessment details recorded'}
                  {reviewCount > 0 ? ` · ${reviewCount} item${reviewCount === 1 ? '' : 's'} need review` : ''}
                </p>
              </div>
              <div className="product-history-actions">
                <span className={`product-status product-status-${status.tone}`}>{status.label}</span>
                <button className="product-button product-button-secondary" type="button" onClick={() => onOpenAudit(record)}>
                  Open audit details
                </button>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </section>
);
</file>

<file path="frontend/src/components/SchemaSelector.tsx">
import React, { useState } from 'react';
import type { ScenarioItem, MigrationRequest } from '../api/client';

interface SchemaSelectorProps {
  scenarios: ScenarioItem[];
  selectedScenarioId: string;
  onSelectScenario: (scenario: ScenarioItem) => void;
  currentRequest: MigrationRequest | null;
  onRequestChange: (request: MigrationRequest) => void;
  onRunMigration: () => void;
  isLoading: boolean;
}

export const SchemaSelector: React.FC<SchemaSelectorProps> = ({
  scenarios,
  selectedScenarioId,
  onSelectScenario,
  currentRequest,
  onRequestChange,
  onRunMigration,
  isLoading,
}) => {
  const [showJsonEditor, setShowJsonEditor] = useState(false);
  const [jsonText, setJsonText] = useState('');
  const [jsonError, setJsonError] = useState<string | null>(null);

  const handleJsonToggle = () => {
    if (!showJsonEditor && currentRequest) {
      setJsonText(JSON.stringify(currentRequest, null, 2));
    }
    setShowJsonEditor(!showJsonEditor);
  };

  const handleJsonApply = () => {
    try {
      const parsed = JSON.parse(jsonText);
      if (!parsed.source_schema || !parsed.destination_schema) {
        throw new Error('Must include source_schema and destination_schema');
      }
      onRequestChange(parsed);
      setJsonError(null);
      setShowJsonEditor(false);
    } catch (err: any) {
      setJsonError(err.message || 'Invalid JSON format');
    }
  };

  return (
    <div className="card">
      <div className="card-header flex-between">
        <div>
          <h2 className="text-lg font-bold text-gray-800">1. Select Migration Scenario / Schema</h2>
          <p className="text-sm text-gray-500">
            Choose a canonical Product Bible §17 scenario or inspect the raw schema payload.
          </p>
        </div>
        <div className="flex gap-2">
          <button
            type="button"
            className="btn btn-secondary text-xs"
            onClick={handleJsonToggle}
          >
            {showJsonEditor ? 'Close JSON Editor' : 'Edit Raw JSON'}
          </button>
          <button
            type="button"
            className="btn btn-primary font-semibold"
            onClick={onRunMigration}
            disabled={isLoading || !currentRequest}
          >
            {isLoading ? (
              <span className="flex items-center gap-2">
                <span className="spinner"></span> Executing Agents...
              </span>
            ) : (
              'Run 5-Agent Migration Pipeline 🚀'
            )}
          </button>
        </div>
      </div>

      <div className="card-body">
        <div className="grid grid-3 gap-3 mb-4">
          {scenarios.map((s) => {
            const isSelected = s.id === selectedScenarioId;
            return (
              <div
                key={s.id}
                onClick={() => onSelectScenario(s)}
                className={`scenario-card ${isSelected ? 'scenario-card-active' : ''}`}
              >
                <div className="flex items-center justify-between mb-1">
                  <span className="badge badge-scenario font-semibold">{s.id.replace('_', ' ').toUpperCase()}</span>
                  {isSelected && <span className="text-xs text-primary font-bold">✓ Selected</span>}
                </div>
                <h4 className="font-bold text-sm text-gray-900 mb-1">{s.name}</h4>
                <p className="text-xs text-gray-600 mb-2 leading-relaxed">{s.description}</p>
                <div className="text-xs text-indigo-700 bg-indigo-50 p-2 rounded border border-indigo-100">
                  <strong>Expected:</strong> {s.expected_behavior}
                </div>
              </div>
            );
          })}
        </div>

        {showJsonEditor && (
          <div className="json-editor-container mb-4">
            <div className="flex-between mb-1">
              <span className="text-xs font-semibold text-gray-700">Custom Schema Payload (JSON)</span>
              {jsonError && <span className="text-xs text-red-600 font-semibold">{jsonError}</span>}
            </div>
            <textarea
              className="json-textarea"
              rows={10}
              value={jsonText}
              onChange={(e) => setJsonText(e.target.value)}
            />
            <div className="flex justify-end gap-2 mt-2">
              <button
                type="button"
                className="btn btn-secondary text-xs"
                onClick={() => setShowJsonEditor(false)}
              >
                Cancel
              </button>
              <button
                type="button"
                className="btn btn-primary text-xs"
                onClick={handleJsonApply}
              >
                Apply Custom JSON Schema
              </button>
            </div>
          </div>
        )}

        {currentRequest && (
          <div className="schema-summary-bar">
            <div className="summary-col">
              <span className="summary-label">Source Table</span>
              <span className="summary-val font-mono">{currentRequest.source_schema.table_name}</span>
              <span className="summary-sub">{currentRequest.source_schema.fields.length} fields</span>
            </div>
            <div className="summary-arrow">➔</div>
            <div className="summary-col">
              <span className="summary-label">Destination Table</span>
              <span className="summary-val font-mono">{currentRequest.destination_schema.table_name}</span>
              <span className="summary-sub">{currentRequest.destination_schema.fields.length} fields</span>
            </div>
            <div className="summary-divider"></div>
            <div className="summary-col">
              <span className="summary-label">Sample Data</span>
              <span className="summary-val">{currentRequest.sample_rows?.length || 0} rows</span>
            </div>
            <div className="summary-col">
              <span className="summary-label">Relationships</span>
              <span className="summary-val">
                {(currentRequest.relationship_metadata?.length || 0) +
                  (currentRequest.destination_schema.relationships?.length || 0)} defined
              </span>
            </div>
          </div>
        )}
      </div>
    </div>
  );
};
</file>

