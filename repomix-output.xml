/* Drawer Shell & Backdrop */
.product-drawer-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  justify-content: flex-end;
}

.product-drawer-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.65);
  backdrop-filter: blur(4px);
  cursor: pointer;
}

.product-drawer-container {
  position: relative;
  z-index: 10000;
  width: min(1200px, 94vw);
  height: 100vh;
  background: #f8fafc;
  box-shadow: -12px 0 40px rgba(0, 0, 0, 0.35);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: width 220ms ease;
  animation: drawerSlideIn 240ms cubic-bezier(0.16, 1, 0.3, 1);
}

.product-drawer-container.is-maximized {
  width: 100vw;
}

@keyframes drawerSlideIn {
  from {
    transform: translateX(100%);
  }
  to {
    transform: translateX(0);
  }
}

/* Drawer Header */
.product-drawer-header {
  background: #0f172a;
