"""
Transformation Agent.
Product Bible §8:
- Responsibility: Determines required casts, defaults, normalizations, or derived transforms.
- Main Input: mapping_candidates + samples
- Main Output: transformation_plan
"""

from typing import List, Dict, Any, Optional
from app.models.schemas import (
    WorkflowContext,
    TransformationAction,
    AgentExecutionOutput,
)
from app.data.transformation_rules import (
    get_transformation_rule,
    apply_sample_transformation,
)
from app.rules.mapping_rules import RULE_3_ID


class TransformationAgent:
    """Specialized domain agent for determining field transformations and casts."""

    AGENT_NAME = "Transformation Agent"
    RESPONSIBILITY = "Determines required casts, defaults, normalizations, or derived transforms."

    def execute(self, context: WorkflowContext) -> WorkflowContext:
        """Evaluate mapping candidates and build transformation plan."""
        if not context.mapping_candidates:
            context.errors.append("Mapping candidates missing for Transformation Agent.")
            return context

        source_field_map = {
            f.get("name"): f for f in context.source_schema.fields if f.get("name")
        }
        dest_field_map = {
            f.get("name"): f for f in context.destination_schema.fields if f.get("name")
        }

        # Sample rows lookup helper
        sample_row = context.sample_rows[0] if context.sample_rows else {}

        actions: List[TransformationAction] = []

        for candidate in context.mapping_candidates:
            dest_name = candidate.destination_field
            src_name = candidate.source_field
            dest_def = dest_field_map.get(dest_name, {})
            src_def = source_field_map.get(src_name, {}) if src_name else {}

            dest_type = dest_def.get("data_type", "string")
            src_type = src_def.get("data_type", "string")

            # Case 1: Default value fill
            if candidate.candidate_type == "DEFAULT_VALUE":
                default_val = dest_def.get("default_value")
                actions.append(
                    TransformationAction(
                        destination_field=dest_name,
                        source_field=None,
                        action_type="DEFAULT_VALUE",
                        transformation_rule="DEFAULT_FILL",
                        confidence_score=100.0,
                        details=f"Populate target field with schema default: '{default_val}'",
                        sample_before=None,
                        sample_after=default_val,
                    )
                )
                continue

            # Case 2: Unmapped field
            if candidate.candidate_type == "UNMAPPED" or not src_name:
                actions.append(
                    TransformationAction(
                        destination_field=dest_name,
                        source_field=None,
                        action_type="NONE",
                        transformation_rule=None,
                        confidence_score=0.0,
                        details="No transformation applicable (unmapped target field).",
                        sample_before=None,
                        sample_after=None,
                    )
                )
                continue

            # Case 3: Type mismatch requiring transformation (Rule 3)
            if "MISMATCH" in candidate.candidate_type:
                rule_info = get_transformation_rule(src_type, dest_type)
                sample_val = sample_row.get(src_name)

                if rule_info:
                    rule_name, rule_desc = rule_info
                    sample_after = apply_sample_transformation(rule_name, sample_val)
                    actions.append(
                        TransformationAction(
                            destination_field=dest_name,
                            source_field=src_name,
                            action_type="TYPE_CAST",
                            transformation_rule=rule_name,
                            confidence_score=70.0,
                            details=f"Rule 3 ({rule_name}): {rule_desc}",
                            sample_before=sample_val,
                            sample_after=sample_after,
                        )
                    )
                else:
                    # Incompatible type
                    actions.append(
                        TransformationAction(
                            destination_field=dest_name,
                            source_field=src_name,
                            action_type="INCOMPATIBLE_TYPE",
                            transformation_rule=None,
                            confidence_score=20.0,
                            details=f"Cannot transform source type '{src_type}' to target type '{dest_type}'.",
                            sample_before=sample_val,
                            sample_after=None,
                        )
                    )
                continue

            # Case 4: Direct compatible mapping
            sample_val = sample_row.get(src_name)
            actions.append(
                TransformationAction(
                    destination_field=dest_name,
                    source_field=src_name,
                    action_type="NO_OP",
                    transformation_rule="DIRECT_COPY",
                    confidence_score=100.0,
                    details=f"Direct 1:1 copy from source '{src_name}' ({src_type}) to target '{dest_name}' ({dest_type}).",
                    sample_before=sample_val,
                    sample_after=sample_val,
                )
            )

        context.transformation_plan = actions

        # Execution Telemetry
        transforms_count = sum(1 for a in actions if a.action_type == "TYPE_CAST")
        defaults_count = sum(1 for a in actions if a.action_type == "DEFAULT_VALUE")
        noop_count = sum(1 for a in actions if a.action_type == "NO_OP")

        context.agent_outputs.append(
            AgentExecutionOutput(
                agent_name=self.AGENT_NAME,
                responsibility=self.RESPONSIBILITY,
                status="SUCCESS",
                input_summary=f"Processed {len(context.mapping_candidates)} candidates with {len(context.sample_rows)} sample rows.",
                output_summary=f"Planned transformations: {noop_count} direct copy, {transforms_count} type conversions, {defaults_count} default fills.",
                details={
                    "type_casts": transforms_count,
                    "default_fills": defaults_count,
                    "direct_copies": noop_count,
                },
            )
        )

        return context
</file>

<file path="backend/app/agents/validation_agent.py">
"""
Validation Agent.
Product Bible §8:
- Responsibility: Checks required target coverage, type compatibility, and relationship integrity.
- Main Input: mapping_plan + target_constraints
- Main Output: validation_results
Implements Rule 4 & Rule 5.
"""

from typing import List, Dict, Any
from app.models.schemas import (
    WorkflowContext,
    ValidationResult,
    ValidationItem,
    AgentExecutionOutput,
)
from app.rules.mapping_rules import (
    RULE_4_ID,
    RULE_5_ID,
)


class ValidationAgent:
    """Specialized domain agent for validating coverage, constraints, and relationships."""

    AGENT_NAME = "Validation Agent"
    RESPONSIBILITY = "Checks required target coverage, type compatibility, and relationship integrity."

    def execute(self, context: WorkflowContext) -> WorkflowContext:
        """Run validation rules against current plan."""
        items: List[ValidationItem] = []
        blocking_issues: List[str] = []
        warning_issues: List[str] = []

        # Lookup tables
        dest_fields = {f.get("name"): f for f in context.destination_schema.fields if f.get("name")}
        candidates = {c.destination_field: c for c in (context.mapping_candidates or [])}
        transforms = {t.destination_field: t for t in (context.transformation_plan or [])}

        # 1. Required Target Coverage Validation (Rule 4)
        for dest_name, dest_def in dest_fields.items():
            is_required = bool(dest_def.get("is_required", False))
            has_default = dest_def.get("default_value") is not None
            candidate = candidates.get(dest_name)
            is_mapped = candidate and candidate.source_field is not None

            if is_required and not is_mapped and not has_default:
                msg = f"Mandatory target field '{dest_name}' has no mapped source field and no default value."
                items.append(
                    ValidationItem(
                        field_name=dest_name,
                        check_type="REQUIRED_COVERAGE",
                        status="FAIL",
                        message=msg,
                        rule_applied=RULE_4_ID,
                    )
                )
                blocking_issues.append(msg)
            elif is_required and not is_mapped and has_default:
                items.append(
                    ValidationItem(
                        field_name=dest_name,
                        check_type="REQUIRED_COVERAGE",
                        status="PASS",
                        message=f"Mandatory target field '{dest_name}' fulfilled via schema default value.",
                        rule_applied="DEFAULT_VALUE_COVERAGE",
                    )
                )
            elif not is_required and not is_mapped:
                items.append(
                    ValidationItem(
                        field_name=dest_name,
                        check_type="REQUIRED_COVERAGE",
                        status="WARNING",
                        message=f"Optional target field '{dest_name}' is unmapped. Will receive NULL.",
                        rule_applied="OPTIONAL_UNMAPPED",
                    )
                )
                warning_issues.append(f"Optional field '{dest_name}' will be null.")
            else:
                items.append(
                    ValidationItem(
                        field_name=dest_name,
                        check_type="REQUIRED_COVERAGE",
                        status="PASS",
                        message=f"Target field '{dest_name}' covered by source field '{candidate.source_field}'.",
                        rule_applied="MAPPED_COVERAGE",
                    )
                )

        # 2. Type Compatibility Validation
        for dest_name, transform in transforms.items():
            if transform.action_type == "INCOMPATIBLE_TYPE":
                msg = f"Target field '{dest_name}' has incompatible type conversion: {transform.details}"
                items.append(
                    ValidationItem(
                        field_name=dest_name,
                        check_type="TYPE_COMPATIBILITY",
                        status="FAIL",
                        message=msg,
                        rule_applied="INCOMPATIBLE_TYPE_RULE",
                    )
                )
                blocking_issues.append(msg)
            elif transform.action_type == "TYPE_CAST":
                items.append(
                    ValidationItem(
                        field_name=dest_name,
                        check_type="TYPE_COMPATIBILITY",
                        status="PASS",
                        message=f"Type cast verified: {transform.details}",
                        rule_applied="TYPE_CONVERSION_VERIFIED",
                    )
                )

        # 3. Relationship & Foreign Key Integrity (Rule 5)
        # "Never silently drop relationship or required-field conflicts"
        source_fields = {f.get("name") for f in context.source_schema.fields if f.get("name")}
        
        for rel in context.relationship_metadata:
            # Check if relationship applies to our destination table
            if rel.source_table == context.destination_schema.table_name:
                rel_field = rel.source_field
                is_rel_required = rel.is_required
                candidate = candidates.get(rel_field)
                
                # Check if the relationship field is mapped from source
                if is_rel_required:
                    if not candidate or not candidate.source_field:
                        msg = (
                            f"Mandatory relational link '{rel.source_table}.{rel.source_field} -> "
                            f"{rel.target_table}.{rel.target_field}' cannot be derived from source schema."
                        )
                        items.append(
                            ValidationItem(
                                field_name=rel_field,
                                check_type="RELATIONSHIP_INTEGRITY",
                                status="FAIL",
                                message=msg,
                                rule_applied=RULE_5_ID,
                            )
                        )
                        blocking_issues.append(msg)
                    else:
                        items.append(
                            ValidationItem(
                                field_name=rel_field,
                                check_type="RELATIONSHIP_INTEGRITY",
                                status="PASS",
                                message=f"Foreign key '{rel_field}' mapped from source field '{candidate.source_field}'.",
                                rule_applied="RELATIONSHIP_PRESERVED",
                            )
                        )

        all_valid = len(blocking_issues) == 0

        val_result = ValidationResult(
            all_valid=all_valid,
            items=items,
            blocking_issues=blocking_issues,
            warning_issues=warning_issues,
        )

        context.validation_results = val_result

        # Execution Telemetry
        passed_count = sum(1 for i in items if i.status == "PASS")
        failed_count = sum(1 for i in items if i.status == "FAIL")
        warn_count = sum(1 for i in items if i.status == "WARNING")

        context.agent_outputs.append(
            AgentExecutionOutput(
                agent_name=self.AGENT_NAME,
                responsibility=self.RESPONSIBILITY,
                status="SUCCESS" if all_valid else "WARNING",
                input_summary=f"Evaluated {len(dest_fields)} fields and {len(context.relationship_metadata)} relationships.",
                output_summary=f"Validation result: {'PASSED' if all_valid else 'FAILED with conflicts'} ({passed_count} pass, {failed_count} fail, {warn_count} warning).",
                details={
                    "all_valid": all_valid,
                    "blocking_issues_count": len(blocking_issues),
                    "warning_issues_count": len(warning_issues),
                    "blocking_issues": blocking_issues,
                },
            )
        )

        return context
